{
  "manifest_version": 3,
  "name": "Link Collector",
  "version": "1.5",
  "description": "Collect, filter and export links from your open tabs as URLs, Markdown, HTML, CSV or JSON.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "favicon",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Link Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Link Collector"
    },
    "copy-all-links": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy tab links without opening the popup"
    }
  }
}
