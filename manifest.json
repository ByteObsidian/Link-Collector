{
  "manifest_version": 3,
  "name": "Link Collector",
  "version": "1.4",
  "description": "Collect, filter and export links from your open tabs as URLs, Markdown, HTML, CSV or JSON.",
  "permissions": [
    "tabs",
    "favicon",
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Link Collector",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Link Collector"
    }
  }
}